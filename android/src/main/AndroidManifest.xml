<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Package visibility.

      An earlier draft used QUERY_ALL_PACKAGES. Lint rejects it, and Play grants
      it to almost nobody, so Device.launchApp resolves launch intents only for
      packages declared here.

      IMPORTANT CONSEQUENCE for the skill-pack flywheel: this list lives in the
      manifest, which means it is fixed at build time. A skill pack delivered
      over the air CANNOT add support for an app that is not listed here — that
      needs an app release. Keep this list ahead of the skill pack.

      SkillPackTest enforces that every package referenced by a skill appears
      below, so the two cannot silently drift apart.
    -->
    <!--
      Needed only by the reasoning tier, which calls the user's chosen model
      provider directly over HTTPS. There is no backend of ours in the path.

      Replaying a known skill needs no network at all, so the app remains useful
      offline and this permission is unused until a key is configured.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.android.settings" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_fingertip"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config">

        <service
            android:name=".FingertipAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">

            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/fingertip_accessibility_config" />
        </service>
    </application>

</manifest>
